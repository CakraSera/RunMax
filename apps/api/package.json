{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:up": "tsx scripts/dev-db.ts up",
    "db:down": "tsx scripts/dev-db.ts down",
    "db:migrate": "pnpm with-env prisma migrate dev",
    "db:generate": "pnpm with-env prisma generate",
    "db:deploy": "pnpm with-env prisma migrate deploy",
    "db:studio": "pnpm with-env prisma studio",
    "smoke": "pnpm with-env tsx scripts/smoke.ts",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@anvia/client": "1.2.0",
    "@anvia/core": "1.5.0",
    "@anvia/memory-prisma": "^1.2.1",
    "@anvia/openai": "1.1.3",
    "@anvia/server": "1.1.4",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.0.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@runmax/agent": "workspace:*",
    "@runmax/domain": "workspace:*",
    "argon2": "^0.45.1",
    "hono": "^4.12.32",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "dotenv": "^17.2.0",
    "dotenv-cli": "^11.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.0",
    "typescript": "~5.9.2"
  }
}
