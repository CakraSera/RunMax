# Model gateway (OpenAI-compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=
WEEKSMITH_MODEL=z-ai/glm-5.3-flash

# Tracing (Langfuse v5 OTEL — LANGFUSE_BASE_URL is the origin, not /otel)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_MEDIA_UPLOAD_ENABLED=false

# Database (docker compose db on localhost:15433)
DATABASE_URL=postgresql://postgres:postgres@localhost:15433/easyday

NODE_ENV=development
