# Model gateway (OpenAI-compatible)
OPENAI_BASE_URL=
OPENAI_API_KEY=
WEEKSMITH_MODEL=glm-5.3-flash

# Tracing (Langfuse v5 OTEL — LANGFUSE_BASE_URL is the origin, not /otel)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_MEDIA_UPLOAD_ENABLED=false

# Database (rootless embedded dev db via `pnpm db:up`, port 54330 —
# host port 15433 belongs to another project's compose db)
DATABASE_URL=postgresql://runmax:runmax@127.0.0.1:54330/runmax

NODE_ENV=development
